generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Drink {
  DrinkID          Int         @id @default(autoincrement())
  DrinkName        String
  DrinkDescription String?     @db.NVarChar(Max)
  DrinkImageURL    String?     @db.VarChar(2048)
  DrinkStatus      String      @db.VarChar(50)
  IsFeatured       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  DrinkSizes       DrinkSize[]
  Recipes          Recipe[]
  Reviews          Review[]

  @@map("Drink")
}

model Size {
  SizeID      Int         @id @default(autoincrement())
  SizeName    String      @db.VarChar(50)
  Description String?     @db.NVarChar(255)
  VolumeML    Int
  WeightGram  Int         @default(500)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  DrinkSizes  DrinkSize[]

  @@map("Size")
}

model DrinkSize {
  DrinkSizeID     Int           @id @default(autoincrement())
  DrinkID         Int
  SizeID          Int
  UnitPrice       Decimal       @db.Decimal(10, 2)
  DrinkSizeStatus String        @default("AVAILABLE") @db.VarChar(50)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Drink           Drink         @relation(fields: [DrinkID], references: [DrinkID], onDelete: Cascade, map: "FK_DrinkSize_Drink")
  Size            Size          @relation(fields: [SizeID], references: [SizeID], onDelete: Cascade, map: "FK_DrinkSize_Size")
  OrderDetails    OrderDetail[]
  CartItems       CartItem[]
  Vouchers        Voucher[]

  @@map("DrinkSize")
}

model Recipe {
  RecipeID      Int            @id @default(autoincrement())
  DrinkID       Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Drink         Drink          @relation(fields: [DrinkID], references: [DrinkID], onDelete: Cascade, map: "FK_Recipe_Drink")
  RecipeDetails RecipeDetail[]

  @@map("Recipe")
}

model Ingredient {
  IngredientID             Int                       @id @default(autoincrement())
  IngredientName           String                    @db.NVarChar(255)
  QuantityStock            Decimal                   @db.Decimal(10, 2)
  UnitID                   Int
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  Unit                     Unit                      @relation(fields: [UnitID], references: [UnitID], map: "FK_Ingredient_Unit")
  IngredientReceiptDetails IngredientReceiptDetail[]
  RecipeDetails            RecipeDetail[]

  @@map("Ingredient")
}

model Unit {
  UnitID      Int          @id @default(autoincrement())
  UnitName    String       @db.NVarChar(50)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Ingredients Ingredient[]

  @@map("Unit")
}

model RecipeDetail {
  RecipeID     Int
  IngredientID Int
  Quantity     Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Ingredient   Ingredient @relation(fields: [IngredientID], references: [IngredientID], map: "FK_RecipeDetail_Ingredient")
  Recipe       Recipe     @relation(fields: [RecipeID], references: [RecipeID], onDelete: Cascade, map: "FK_RecipeDetail_Recipe")

  @@id([RecipeID, IngredientID])
  @@map("RecipeDetail")
}

model Supplier {
  SupplierID         Int                 @id @default(autoincrement())
  SupplierName       String              @db.NVarChar(255)
  SupplierEmail      String              @db.VarChar(255)
  Street             String?             @db.NVarChar(255)
  AddressNumber      String?             @db.NVarChar(50)
  City               String?             @db.NVarChar(100)
  District           String?             @db.NVarChar(100)
  Ward               String?             @db.NVarChar(100)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  IngredientReceipts IngredientReceipt[]
  SupplierPhones     SupplierPhone[]

  @@map("Supplier")
}

model SupplierPhone {
  SupplierPhoneID Int      @id @default(autoincrement())
  SupplierID      Int
  PhoneNumber     String   @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Supplier        Supplier @relation(fields: [SupplierID], references: [SupplierID], onDelete: Cascade, map: "FK_SupplierPhone_Supplier")

  @@map("SupplierPhone")
}

model IngredientReceipt {
  IngredientReceiptID      Int                       @id @default(autoincrement())
  SupplierID               Int
  ShipperID                Int?
  ReceivedDate             DateTime
  IngredientReceiptStatus  String                    @db.VarChar(50)
  ShippingAddress          String?                   @db.NVarChar(255)
  Latitude                 Float?
  Longitude                Float?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  Supplier                 Supplier                  @relation(fields: [SupplierID], references: [SupplierID], map: "FK_IngredientReceipt_Supplier")
  Shipper                  Employee?                 @relation("ReceiptShipper", fields: [ShipperID], references: [EmployeeID], onDelete: NoAction, onUpdate: NoAction, map: "FK_IngredientReceipt_Shipper")
  IngredientReceiptDetails IngredientReceiptDetail[]

  @@map("IngredientReceipt")
}

model IngredientReceiptDetail {
  IngredientReceiptID Int
  IngredientID        Int
  Quantity            Decimal           @db.Decimal(10, 2)
  CostPrice           Decimal           @db.Decimal(10, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  Ingredient          Ingredient        @relation(fields: [IngredientID], references: [IngredientID], map: "FK_IngredientReceiptDetail_Ingredient")
  IngredientReceipt   IngredientReceipt @relation(fields: [IngredientReceiptID], references: [IngredientReceiptID], onDelete: Cascade, map: "FK_IngredientReceiptDetail_IngredientReceipt")

  @@id([IngredientReceiptID, IngredientID])
  @@map("IngredientReceiptDetail")
}

model MemberShipLevel {
  LevelID       Int        @id @default(autoincrement())
  LevelName     String     @db.NVarChar(50)
  DiscountRate  Decimal    @db.Decimal(5, 2)
  RequiredMoney Decimal    @db.Decimal(15, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  Customers     Customer[]

  @@map("MemberShipLevel")
}

model Customer {
  CustomerID         Int             @id @default(autoincrement())
  CustomerName       String          @db.NVarChar(255)
  Email              String?         @db.VarChar(255)
  PhoneNumber        String          @db.VarChar(20)
  TotalMoneySpending Decimal         @db.Decimal(15, 2)
  LevelID            Int
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  Carts              Cart[]
  ChatSessions       ChatSession[]
  MemberShipLevel    MemberShipLevel @relation(fields: [LevelID], references: [LevelID], map: "FK_Customer_MemberShipLevel")
  Orders             Orders[]
  Reviews            Review[]
  Vouchers           Voucher[]

  @@map("Customer")
}

model ShopTable {
  ShopTableID     Int      @id @default(autoincrement())
  ShopTableNumber Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Orders          Orders[]

  @@map("ShopTable")
}

model Orders {
  OrderID         Int           @id @default(autoincrement())
  CustomerID      Int?
  ShopTableID     Int?
  EmployeeID      Int
  ShipperID       Int?
  OrderType       String        @default("DINE_IN") @db.VarChar(50)
  ShippingAddress String?       @db.NVarChar(255)
  Latitude        Float?
  Longitude       Float?
  Distance        Float?
  ReceiverName    String?       @db.NVarChar(255)
  ReceiverPhone   String?       @db.VarChar(20)
  ProvinceID      Int?
  DistrictID      Int?
  WardCode        String?       @db.VarChar(50)
  GHN_OrderCode   String?       @db.VarChar(100)
  ShippingFee     Decimal?      @default(0) @db.Decimal(10, 2)
  DeliveryMethod  String?       @db.VarChar(50)
  TrackingURL     String?       @db.VarChar(500)
  CreatedTime     DateTime      @default(now())
  OrderStatus     String        @default("PENDING") @db.VarChar(50)
  TotalPrice      Decimal       @db.Decimal(10, 2)
  OrderNote       String?       @db.NVarChar(500)
  PaymentMethod   String?       @db.VarChar(50)
  PaymentStatus   String?       @db.VarChar(50)
  AppTransId      String?       @db.VarChar(100)
  RefundReason    String?       @db.NVarChar(500)
  RefundStatus    String?       @db.VarChar(50)
  RefundBankCode  String?       @db.VarChar(50)
  RefundAccountNumber String?   @db.VarChar(50)
  RefundAccountName String?     @db.NVarChar(255)
  VoucherID       Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  OrderDetails    OrderDetail[]
  Customer        Customer?     @relation(fields: [CustomerID], references: [CustomerID], onDelete: SetNull, map: "FK_Orders_Customer")
  Voucher         Voucher?      @relation(fields: [VoucherID], references: [VoucherID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Orders_Voucher")
  Employee        Employee      @relation("OrderCreator", fields: [EmployeeID], references: [EmployeeID], map: "FK_Orders_Employee")
  Shipper         Employee?     @relation("OrderShipper", fields: [ShipperID], references: [EmployeeID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Orders_Shipper")
  ShopTable       ShopTable?    @relation(fields: [ShopTableID], references: [ShopTableID], map: "FK_Orders_ShopTable")
  Reviews         Review[]

  @@map("Orders")
}

model OrderDetail {
  OrderDetailID Int       @id @default(autoincrement())
  OrderID       Int
  DrinkSizeID   Int
  Quantity      Int
  Sugar         String    @default("100%") @db.VarChar(20)
  Ice           String    @default("100%") @db.VarChar(20)
  Toppings      String?   @db.NVarChar(500)
  UnitPrice     Decimal   @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  DrinkSize     DrinkSize @relation(fields: [DrinkSizeID], references: [DrinkSizeID], map: "FK_OrderDetail_DrinkSize")
  Orders        Orders    @relation(fields: [OrderID], references: [OrderID], onDelete: Cascade, map: "FK_OrderDetail_Orders")

  @@map("OrderDetail")
}

model Employee {
  EmployeeID    Int          @id @default(autoincrement())
  FullName      String       @db.NVarChar(255)
  PhoneNumber   String       @db.VarChar(20)
  Email         String       @db.VarChar(255)
  Birth         DateTime
  Sex           String       @db.VarChar(20)
  PINCode       String       @db.VarChar(10)
  password      String       @db.VarChar(255)
  RoleID        Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Role          EmployeeRole @relation(fields: [RoleID], references: [RoleID], map: "FK_Employee_EmployeeRole")
  Orders        Orders[]     @relation("OrderCreator")
  ShippedOrders Orders[]     @relation("OrderShipper")
  ShippedReceipts IngredientReceipt[] @relation("ReceiptShipper")
  Salaries      Salary[]
  ShiftLogs     ShiftLog[]

  @@map("Employee")
}

model EmployeeRole {
  RoleID            Int        @id @default(autoincrement())
  RoleName          String     @db.NVarChar(100)
  Description       String?    @db.NVarChar(255)
  DefaultBaseSalary Decimal    @db.Decimal(15, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  Employees         Employee[]

  @@map("EmployeeRole")
}

model Salary {
  SalaryID   Int       @id @default(autoincrement())
  EmployeeID Int
  Month      Int
  Year       Int
  BaseSalary Decimal   @db.Decimal(15, 2)
  TotalHours Decimal   @db.Decimal(6, 2)
  Bonus      Decimal   @db.Decimal(15, 2)
  Deduction  Decimal   @db.Decimal(15, 2)
  RealSalary Decimal   @db.Decimal(15, 2)
  PaidDate   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Employee   Employee  @relation(fields: [EmployeeID], references: [EmployeeID], onDelete: Cascade, map: "FK_Salary_Employee")

  @@map("Salary")
}

model Shift {
  ShiftID   Int        @id @default(autoincrement())
  ShiftName String     @db.NVarChar(100)
  StartTime String     @db.VarChar(10)
  EndTime   String     @db.VarChar(10)
  Note      String?    @db.NVarChar(255)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  ShiftLogs ShiftLog[]

  @@map("Shift")
}

model ShiftLog {
  ShiftLogID   Int       @id @default(autoincrement())
  EmployeeID   Int
  ShiftID      Int
  WorkDate     DateTime
  CheckInTime  DateTime?
  CheckOutTime DateTime?
  ShiftStatus  String    @db.VarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Employee     Employee  @relation(fields: [EmployeeID], references: [EmployeeID], onDelete: Cascade, map: "FK_ShiftLog_Employee")
  Shift        Shift     @relation(fields: [ShiftID], references: [ShiftID], map: "FK_ShiftLog_Shift")

  @@map("ShiftLog")
}

model Cart {
  CartID     Int        @id @default(autoincrement())
  SessionID  String?    @db.VarChar(100)
  CustomerID Int?
  Status     String     @default("ACTIVE") @db.VarChar(50)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  Customer   Customer?  @relation(fields: [CustomerID], references: [CustomerID], onDelete: Cascade, map: "FK_Cart_Customer")
  CartItems  CartItem[]

  @@map("Cart")
}

model CartItem {
  CartItemID  Int      @id @default(autoincrement())
  CartID      Int
  DrinkSizeID Int
  Quantity    Int
  Sugar       String   @default("100%") @db.VarChar(20)
  Ice         String   @default("100%") @db.VarChar(20)
  Toppings    String?  @db.NVarChar(500)
  UnitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Cart        Cart      @relation(fields: [CartID], references: [CartID], onDelete: Cascade, map: "FK_CartItem_Cart")
  DrinkSize   DrinkSize @relation(fields: [DrinkSizeID], references: [DrinkSizeID], map: "FK_CartItem_DrinkSize")

  @@map("CartItem")
}

model Review {
  ReviewID   Int      @id @default(autoincrement())
  CustomerID Int
  DrinkID    Int
  OrderID    Int?
  Rating     Int      @db.TinyInt
  Comment    String?  @db.NVarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Customer   Customer @relation(fields: [CustomerID], references: [CustomerID], onDelete: Cascade, map: "FK_Review_Customer")
  Drink      Drink    @relation(fields: [DrinkID], references: [DrinkID], onDelete: Cascade, map: "FK_Review_Drink")
  Order      Orders?  @relation(fields: [OrderID], references: [OrderID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Review_Order")

  @@map("Review")
}

model ChatSession {
  SessionID  String        @id @default(uuid()) @db.UniqueIdentifier
  CustomerID Int?
  Status     String        @default("AI_HANDLING") @db.VarChar(50)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  Messages   ChatMessage[]
  Customer   Customer?     @relation(fields: [CustomerID], references: [CustomerID], onDelete: Cascade, map: "FK_ChatSession_Customer")

  @@map("ChatSession")
}

model ChatMessage {
  MessageID  Int         @id @default(autoincrement())
  SessionID  String      @db.UniqueIdentifier
  SenderType String      @db.VarChar(20)
  Content    String      @db.NVarChar(Max)
  createdAt  DateTime    @default(now())
  Session    ChatSession @relation(fields: [SessionID], references: [SessionID], onDelete: Cascade, map: "FK_ChatMessage_ChatSession")

  @@map("ChatMessage")
}

model Voucher {
  VoucherID       Int         @id @default(autoincrement())
  Code            String      @unique @db.VarChar(50)
  DiscountType    String      @default("PERCENT") @db.VarChar(20)
  DiscountValue   Decimal     @db.Decimal(15, 2)
  TargetProductID Int?
  OwnerID         Int?
  Creator         String?     @db.VarChar(50)
  IsUsed          Boolean     @default(false)
  ValidUntil      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  Customer        Customer?   @relation(fields: [OwnerID], references: [CustomerID], map: "FK_Voucher_Customer")
  DrinkSize       DrinkSize?  @relation(fields: [TargetProductID], references: [DrinkSizeID], map: "FK_Voucher_DrinkSize")
  Orders          Orders[]

  @@map("Voucher")
}

model Promotion {
  PromotionID    Int         @id @default(autoincrement())
  Name           String      @db.NVarChar(255)
  Description    String?     @db.NVarChar(500)
  Type           String      @default("PERCENT") @db.VarChar(20)
  Value          Decimal     @db.Decimal(15, 2)
  MinQuantity    Int         @default(2)
  TargetDrinkIDs String?     @db.NVarChar(500)
  IsActive       Boolean     @default(true)
  IsCombo        Boolean     @default(false)
  StartDate      DateTime?
  EndDate        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("Promotion")
}

model HighUtilityItemset {
  HUI_ID          Int      @id @default(autoincrement())
  Itemset         String   @db.VarChar(255)
  TotalUtility    Decimal  @db.Decimal(15, 2)
  SupportCount    Int
  Rank            Int
  LastCalculated  DateTime @default(now())
  
  @@map("HighUtilityItemset")
}
