INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (37, N'f689505e-629c-483e-aaa6-98838b954720', N'AI', N'Dạ, em xin lỗi anh/chị ạ. Hệ thống báo là anh/chị đã nhận mã giảm giá từ Phêla trong tháng này rồi nên em chưa thể tặng thêm mã mới cho mình được ạ. Anh/chị thông cảm giúp em nhé.', CAST(N'2026-07-02T07:07:03.3170000' AS DateTime2))
