INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (1, N'85cc543c-5421-41cd-9f4b-7d3306ac30f1', N'CUSTOMER', N'giá hơi đắt cho tôi voucher đi', CAST(N'2026-07-01T08:23:03.7370000' AS DateTime2))
GO
INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (2, N'85cc543c-5421-41cd-9f4b-7d3306ac30f1', N'AI', N'Dạ em xin lỗi anh/chị ạ, hiện tại hệ thống báo là chưa thể tặng mã giảm giá cho mình được do anh/chị chưa đăng nhập ạ. Anh/chị có thể đăng nhập để nhận mã ạ. Rất xin lỗi vì sự bất tiện này ạ.', CAST(N'2026-07-01T08:23:07.9790000' AS DateTime2))
GO
INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (3, N'32acb544-63f6-4fad-bd1a-9910df15ac89', N'CUSTOMER', N'cho tôi voucher đi', CAST(N'2026-07-01T08:23:39.8240000' AS DateTime2))
GO
INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (4, N'32acb544-63f6-4fad-bd1a-9910df15ac89', N'AI', N'Dạ, em xin lỗi ạ. Hiện tại hệ thống báo là anh/chị chưa đăng nhập nên chưa thể tặng mã giảm giá được ạ. Anh/chị vui lòng đăng nhập để em có thể gửi tặng voucher ưu đãi nhé.', CAST(N'2026-07-01T08:23:43.5310000' AS DateTime2))
GO
