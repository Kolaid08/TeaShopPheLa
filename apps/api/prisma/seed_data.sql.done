INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (12, N'6f6cdbe6-75c3-4bc2-9bfa-dd97f6927663', N'AI', N'Dạ em gửi anh chị mã giảm giá 10% cho món Sữa Tươi Trân Châu Đường Đen ạ: [BUY_NOW:PHELA-AI-4T39TV:36]
