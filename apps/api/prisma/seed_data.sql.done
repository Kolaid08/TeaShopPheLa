INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (14, N'6f6cdbe6-75c3-4bc2-9bfa-dd97f6927663', N'AI', N'Dạ anh/chị ơi, do anh/chị đã nhận mã giảm giá từ Phêla trong tháng này rồi nên em chưa thể tặng thêm mã khác được ạ. Anh/chị thông cảm giúp em nhé.

Anh/chị có thể sử dụng mã giảm giá 10% cho món Sữa Tươi Trân Châu Đường Đen mà em đã gửi trước đó để chốt đơn luôn ạ. Chúc anh/chị ngon miệng!', CAST(N'2026-07-01T12:09:01.3320000' AS DateTime2))
GO
