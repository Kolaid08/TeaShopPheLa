INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (10, N'1e689ad2-49f7-4612-8967-981d11e2be65', N'AI', N'Dạ em xin lỗi anh/chị ạ. Hiện tại hệ thống báo là mình vẫn chưa đăng nhập nên chưa thể tặng mã giảm giá được ạ. Anh/chị vui lòng đăng nhập để nhận ưu đãi từ Phê La nhé.', CAST(N'2026-07-01T11:50:49.8960000' AS DateTime2))
