INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (31, N'e39982ce-8fd5-4a69-9921-ed337428b4b0', N'CUSTOMER', N'tôi muốn uống hồng trà sữa và 1 loại đồ uống khác nữa, hãy cho tôi gợi ý với', CAST(N'2026-07-02T03:44:58.5380000' AS DateTime2))
GO
INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (32, N'e39982ce-8fd5-4a69-9921-ed337428b4b0', N'AI', N'Dạ chào anh/chị, rất vui được phục vụ ạ! Anh/chị đã chọn Hồng Trà Sữa là một lựa chọn tuyệt vời luôn ạ.

Để gợi ý một thức uống khác, em mời anh/chị tham khảo món Trà Xoài Macchiato nhé ạ. Món này có vị trà thơm mát kết hợp với vị xoài chua ngọt và lớp Macchiato béo ngậy rất được các khách yêu thích ạ.

Anh/chị muốn dùng thêm món nào nữa không ạ?', CAST(N'2026-07-02T03:45:03.8270000' AS DateTime2))
GO
INSERT [dbo].[ChatMessage] ([MessageID], [SessionID], [SenderType], [Content], [createdAt]) VALUES (33, N'e39982ce-8fd5-4a69-9921-ed337428b4b0', N'CUSTOMER', N'vậy cặp loại đồ uống ngta hay mua chung với nhau là gì', CAST(N'2026-07-02T03:46:01.1530000' AS DateTime2))
GO
